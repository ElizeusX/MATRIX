# Local development only; replace defaults in hosted environments.
POSTGRES_DB=matrix
POSTGRES_USER=matrix
POSTGRES_PASSWORD=local-dev-only
DATABASE_URL=postgres://matrix:local-dev-only@localhost:5432/matrix?sslmode=disable
API_PORT=8080
SITE_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
MATRIX_API_INTERNAL_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LiqPay is disabled until all required values are configured.
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SERVER_URL=
LIQPAY_RESULT_URL=
LIQPAY_SANDBOX=false
